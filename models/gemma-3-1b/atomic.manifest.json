{
  "$schema": "atomics://local.dns.route",
  "id": "gemma-3-1b-it",
  "block": "FRAME",
  "version": "1.0.0",
  "backend": "kuhul_engine",
  "execution_gated": true,
  "feed_parser": "xcfe://tree-sitter-wasm",
  "blocks": ["HEADER", "MENU", "BODY", "FEED", "FOOTER"],
  "model": {
    "id": "gemma-3-1b-it-qat",
    "arch": "gemma3",
    "params": "1B",
    "quant": "Q4_0 QAT",
    "size_mb": 687,
    "gpu_fit": true,
    "note": "Gemma 3 1B IT QAT-quantized. 687 MB — very comfortable on HD 4600. Fastest resident model.",
    "gguf": "C:\\Users\\canna\\.lmstudio\\models\\lmstudio-community\\gemma-3-1B-it-QAT-GGUF\\gemma-3-1B-it-QAT-Q4_0.gguf"
  },
  "chat_template": {
    "format": "gemma3",
    "roles": {
      "system":    "<start_of_turn>user",
      "user":      "<start_of_turn>user",
      "assistant": "<start_of_turn>model"
    },
    "specials": {
      "bos": "<bos>",
      "eos": "<eos>",
      "turn_end": "<end_of_turn>",
      "turn_sep": "<end_of_turn>\n"
    },
    "tool_call": {
      "format": "json_block",
      "note": "Gemma 3 uses JSON-in-text tool calls, not dedicated tokens. Wrap in ```json``` fences."
    },
    "generation_prompt": "<start_of_turn>model\n",
    "stock_adapter": "tools/kxml_stock_adapter.py",
    "stock_adapter_style": "inline",
    "note": "System prompt folds into first user turn for Gemma 3 (no dedicated system role)."
  },
  "sampling": {
    "temperature": 0.7,
    "repeat_penalty": 1.05,
    "top_p": 0.95,
    "stop": ["<end_of_turn>", "<eos>"]
  },
  "app": {
    "kind": "chat",
    "title": "Gemma 3 1B IT",
    "input": "terminal",
    "io_plane": "terminal",
    "npc": {
      "id": "gemma-3-1b",
      "name": "Gemma",
      "role": "fast lightweight assistant",
      "tone": "friendly, brief",
      "system_prompt": "You are Gemma, a 1B parameter assistant. You are fast and lightweight. Answer clearly and briefly. When you need to call a tool, use a JSON code block.",
      "rules": [
        "Keep answers short unless detail is asked.",
        "System prompt goes in the first user turn.",
        "Use JSON blocks for tool calls."
      ],
      "context": {
        "source": "state://chat.history",
        "max_turns": 16,
        "include_manifest": false
      }
    },
    "provider": {
      "kind": "kuhul_engine",
      "endpoint": "http://127.0.0.1:17480/v1/chat/completions",
      "model": "gemma-3-1B-it-QAT-Q4_0.gguf",
      "gpu_layers": 999,
      "request_route": "task://chat.submit",
      "response_route": "state://chat.reply_log"
    },
    "micronauts": {
      "default": "micronauts/chat.json"
    }
  }
}
