{
  "$schema": "atomics://local.dns.route",
  "id": "gemma-3-1b-it-q8",
  "block": "FRAME",
  "version": "1.0.0",
  "backend": "kuhul_engine",
  "execution_gated": true,
  "feed_parser": "xcfe://tree-sitter-wasm",
  "blocks": ["HEADER", "MENU", "BODY", "FEED", "FOOTER"],
  "display": {
    "alias": "Gemma 1B Q8",
    "description": "Gemma 3 1B IT Q8 (unsloth) — highest-quality 1B GPU resident",
    "group": "Fast"
  },
  "model": {
    "id": "gemma-3-1b-it-q8",
    "arch": "gemma3",
    "params": "1B",
    "quant": "Q8_0",
    "size_mb": 1020,
    "gpu_fit": true,
    "note": "1020 MB — fits HD 4600 with 772 MB headroom. Full Q8 quality, higher fidelity than the QAT Q4 variant (gemma-1b alias). Use when quality matters more than speed.",
    "gguf": "C:\\Users\\canna\\.lmstudio\\models\\unsloth\\gemma-3-1b-it-GGUF\\gemma-3-1b-it-Q8_0.gguf"
  },
  "chat_template": {
    "format": "gemma3",
    "roles": {
      "system":    "<start_of_turn>user",
      "user":      "<start_of_turn>user",
      "assistant": "<start_of_turn>model"
    },
    "specials": {
      "bos":      "<bos>",
      "eos":      "<eos>",
      "turn_end": "<end_of_turn>",
      "turn_sep": "<end_of_turn>\n"
    },
    "tool_call": {
      "format": "json_block",
      "note": "System prompt folds into first user turn. Use JSON fences for tool calls."
    },
    "generation_prompt": "<start_of_turn>model\n",
    "stock_adapter": "tools/kxml_stock_adapter.py",
    "stock_adapter_style": "inline",
    "note": "System prompt folds into first user turn for Gemma 3 (no dedicated system role)."
  },
  "sampling": {
    "temperature": 0.7,
    "repeat_penalty": 1.05,
    "top_p": 0.95,
    "stop": ["<end_of_turn>", "<eos>"]
  },
  "app": {
    "kind": "chat",
    "title": "Gemma 1B Q8",
    "input": "terminal",
    "io_plane": "terminal",
    "npc": {
      "id": "gemma-3-1b-q8",
      "name": "Gemma",
      "role": "fast lightweight assistant (full Q8 quality)",
      "tone": "friendly, concise",
      "system_prompt": "You are Gemma, a 1B parameter instruction-tuned model at full Q8 quality. Answer clearly and briefly. When you need to call a tool, use a JSON code block.",
      "rules": [
        "Keep answers short unless detail is requested.",
        "System prompt goes in the first user turn.",
        "Use JSON blocks for tool calls."
      ],
      "context": {
        "source": "state://chat.history",
        "max_turns": 16,
        "include_manifest": false
      }
    },
    "provider": {
      "kind": "kuhul_engine",
      "endpoint": "http://127.0.0.1:17474/v1/chat/completions",
      "model": "gemma-3-1b-it-Q8_0.gguf",
      "gpu_layers": 999,
      "request_route": "task://chat.submit",
      "response_route": "state://chat.reply_log"
    },
    "micronauts": {
      "default": "micronauts/chat.json"
    }
  }
}
