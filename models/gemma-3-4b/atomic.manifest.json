{
  "$schema": "atomics://local.dns.route",
  "id": "gemma-3-4b-it",
  "block": "FRAME",
  "version": "1.0.0",
  "backend": "kuhul_engine",
  "execution_gated": true,
  "feed_parser": "xcfe://tree-sitter-wasm",
  "blocks": ["HEADER", "MENU", "BODY", "FEED", "FOOTER"],
  "model": {
    "id": "gemma-3-4b-it",
    "arch": "gemma3",
    "params": "4B",
    "quant": "Q4_K_M",
    "size_mb": null,
    "gpu_fit": false,
    "note": "Still downloading (gemma-3-4b-it-Q4_K_M.gguf). Estimated ~2.7 GB — will exceed HD 4600 ceiling; CPU-only. Update gguf path when download completes.",
    "gguf": "C:\\Users\\canna\\.lmstudio\\models\\lmstudio-community\\gemma-3-4b-it-GGUF\\gemma-3-4b-it-Q4_K_M.gguf"
  },
  "chat_template": {
    "format": "gemma3",
    "roles": {
      "system":    "<start_of_turn>user",
      "user":      "<start_of_turn>user",
      "assistant": "<start_of_turn>model"
    },
    "specials": {
      "bos": "<bos>",
      "eos": "<eos>",
      "turn_end": "<end_of_turn>",
      "turn_sep": "<end_of_turn>\n"
    },
    "tool_call": {
      "format": "json_block"
    },
    "generation_prompt": "<start_of_turn>model\n",
    "stock_adapter": "tools/kxml_stock_adapter.py",
    "stock_adapter_style": "inline"
  },
  "sampling": {
    "temperature": 0.7,
    "repeat_penalty": 1.05,
    "top_p": 0.95,
    "stop": ["<end_of_turn>", "<eos>"]
  },
  "app": {
    "kind": "chat",
    "title": "Gemma 3 4B IT",
    "input": "terminal",
    "io_plane": "terminal",
    "npc": {
      "id": "gemma-3-4b",
      "name": "Gemma 3 4B",
      "role": "capable mid-size assistant",
      "tone": "clear, structured",
      "system_prompt": "You are Gemma 3 4B, a capable instruction-tuned model. Answer precisely. System prompt folds into the first user turn.",
      "context": {
        "source": "state://chat.history",
        "max_turns": 16,
        "include_manifest": false
      }
    },
    "provider": {
      "kind": "kuhul_engine",
      "endpoint": "http://127.0.0.1:17480/v1/chat/completions",
      "model": "gemma-3-4b-it-Q4_K_M.gguf",
      "gpu_layers": 0,
      "request_route": "task://chat.submit",
      "response_route": "state://chat.reply_log"
    },
    "micronauts": {
      "default": "micronauts/chat.json"
    }
  }
}
