__pycache__/
*.pyc

# Native build artifacts — the runnable .exe are archived in scratch/verification-binaries.zip
# (with rebuild instructions); everything here is rebuildable from tracked sources.
*.exe
*.obj
*.cso
*.pdb
*.ilk
*.log
scratch/*.bin

# Large generated birdsong data — kept local; the model folder carries a self-contained
# 2MB birdsong_mesh.stb, so the geometry model stays reproducible without the 27MB raw dump.
brain2/

# scratch test tensors (the committed .stb live under models/)
scratch/*.stb

# nested scratch build inputs/outputs (block driver)
scratch/**/*.bin
scratch/block/*.hlsl

# infer driver: emitted kernels + large/binary data (harness .cpp + build.bat + dims stay)
scratch/**/*.hlsl
scratch/**/*.weights
scratch/infer/gpt2.prompt
scratch/infer/gpt2.expected

# DirectML redist (pulled from NuGet Microsoft.AI.DirectML; not vendored in-repo)
scratch/dml/DirectML.dll
scratch/dml/lib/
scratch/dml/include/
scratch/dml/dml_gemm.dll
scratch/dml/*.lib
scratch/dml/*.exp
scratch/dml/mlp_dims.txt
scratch/dml/attn_dims.txt
scratch/dml/ly_dims.txt
scratch/dml/mdl_dims.txt
scratch/dml/gen_seq.txt
scratch/dml/*_trace.txt
scratch/dml/gen_out.txt
scratch/s002/
desktop/PRIMEOS/bin/
desktop/PRIMEOS/obj/
desktop/semantic_engine/

# Qwen runtime weight payloads (archive of record: E:\models\Qwen1.8B-quant\); manifests ARE tracked
models/khanary-qwen1_8b-v0.1.0/*.kqz

# built KHANARY server binaries (bundled at package time, not committed)
/dist/

# transient runtime files
scratch/*.pid
scratch/*.out
scratch/*.gguf

# build trees (submodule clones + built UI)
khanary-llama-build/
khanary-ui-build/

# from-scratch training weights (large, local only)
models/from_zero/
.deepseek/
