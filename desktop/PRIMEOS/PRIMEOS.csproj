<Project Sdk="Microsoft.NET.Sdk">
  <!-- KHANARY-packaged PRIMEOS Shell. Fixes vs the .ASX.cpp build: retargeted net6->net8
       (net6 runtime is not installed; net8 WindowsDesktop is), and App.xaml StartupUri points at
       the real window file (PRIMEOS-Shell.xaml) instead of the nonexistent MainWindow.xaml.
       Self-contained WPF chat shell -> connects to a local LLAMA server; no MCP dependency. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PRIMEOS</AssemblyName>
    <RootNamespace>PRIMEOS</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <!-- Part 1 of the PRIMEOS architecture: a WebView2 shell over llama-server's web UI.
       The canvas is a WebView2 (Microsoft.Edge Chromium) pointed at the local llama UI, replacing
       the legacy IE-based WebBrowser control (which can't run a modern SvelteKit UI). Needs the
       WebView2 Runtime installed (ships with Edge on Win10/11). Restore needs network the first time. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="primeos-app.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
