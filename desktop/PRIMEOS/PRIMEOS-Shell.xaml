<Window x:Class="PRIMEOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PRIMEOS Shell - Layer 6 Orchestration Interface"
        Width="1400" Height="900"
        Background="#0a0e27"
        Foreground="#00ff00"
        FontFamily="Consolas"
        FontSize="12"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1a1e37"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="BorderBrush" Value="#00ff00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2a2e47"/>
                    <Setter Property="Foreground" Value="#00ff99"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0f1629"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="BorderBrush" Value="#00ff00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="CaretBrush" Value="#00ff00"/>
        </Style>

        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#0f1629"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="BorderBrush" Value="#00ff00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1a1e37"/>
            <Setter Property="Foreground" Value="#00ff00"/>
            <Setter Property="BorderBrush" Value="#00ff00"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             HEADER: Mode selector + Status
             ============================================================ -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="▶ PRIMEOS SHELL" Foreground="#00ff99" FontWeight="Bold" VerticalAlignment="Center"/>
                <Separator Width="1" Background="#00ff00" Margin="8,0"/>
                
                <ComboBox Name="ModeSelector" Width="120" Style="{StaticResource DarkComboBox}" VerticalAlignment="Center">
                    <ComboBoxItem>ORCHESTRATE</ComboBoxItem>
                    <ComboBoxItem>SEMANTIC</ComboBoxItem>
                    <ComboBoxItem>INFERENCE</ComboBoxItem>
                    <ComboBoxItem>DEBUG</ComboBoxItem>
                </ComboBox>
                
                <TextBlock x:Name="StatusText" Text="[IDLE]" Foreground="#00ff00" VerticalAlignment="Center" Margin="16,0" FontFamily="Courier New"/>
                
                <Button Name="ConnectButton" Content="CONNECT LLAMA" Style="{StaticResource DarkButton}" Click="ConnectLlama_Click" VerticalAlignment="Center"/>
                <Button Name="ClearButton" Content="CLEAR ALL" Style="{StaticResource DarkButton}" Click="Clear_Click" VerticalAlignment="Center"/>
                <Separator Width="1" Background="#004400" Margin="8,0"/>
                <CheckBox Name="AtomicRepliesToggle" Content="ATOMIC" Foreground="#006600"
                          VerticalAlignment="Center" Margin="4,0"
                          IsChecked="False" Checked="AtomicReplies_Changed" Unchecked="AtomicReplies_Changed"
                          ToolTip="Render chat replies as Atomic DOM blocks instead of HTML"/>
            </StackPanel>
        </Border>

        <!-- ============================================================
             LEFT PANEL: Registry + Delta Commands
             ============================================================ -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0a0e27" BorderBrush="#00ff00" BorderThickness="0,1,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Registry Explorer -->
                <TextBlock Grid.Row="0" Text="≡ REGISTRY" Foreground="#00ff99" FontWeight="Bold" Margin="8,4"/>
                
                <ListBox Grid.Row="1" Name="RegistryList" Style="{StaticResource DarkListBox}" 
                         SelectionChanged="RegistryItem_Selected" Padding="4">
                    <ListBoxItem>
                        <TextBlock Text="▸ AGENTS" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="▸ SKILLS" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="▸ PLUGINS" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="▸ TOOLS" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="▸ MICRONAUTS" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="▸ OPCODES" Foreground="#00ff00"/>
                    </ListBoxItem>
                </ListBox>

                <!-- Delta Commands -->
                <TextBlock Grid.Row="2" Text="∆ DELTA COMMANDS" Foreground="#00ff99" FontWeight="Bold" Margin="8,4"/>
                
                <ListBox Grid.Row="3" Name="DeltaCommandList" Style="{StaticResource DarkListBox}" Padding="4">
                    <ListBoxItem>
                        <TextBlock Text="[CREATE] New Agent" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="[UPDATE] Skill Config" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="[DELETE] Micronaut" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="[ROUTE] Expert Query" Foreground="#00ff99"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="[VALIDATE] Phase" Foreground="#00ff00"/>
                    </ListBoxItem>
                    <ListBoxItem>
                        <TextBlock Text="[EXECUTE] Opcode" Foreground="#00ff00"/>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============================================================
             CENTER PANEL: Command Editor + Canvas
             ============================================================ -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Background="#0f1629" BorderBrush="#00ff00" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- Command Input -->
                <TextBlock Grid.Row="0" Text="→ COMMAND INPUT" Foreground="#00ff99" FontWeight="Bold" Margin="8,4"/>
                
                <TextBox Grid.Row="1" Name="CommandInput" Style="{StaticResource DarkTextBox}"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Foreground="#00ff00" Background="#0a0e27" Margin="4"
                         TextWrapping="Wrap" />

                <!-- Canvas Separator -->
                <Separator Grid.Row="2" Background="#00ff00" Height="1" VerticalAlignment="Top" Margin="0,4"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock Text="◄ CANVAS OUTPUT" Foreground="#00ff99" FontWeight="Bold"/>
                    <Button Name="RunButton" Content="▶ RUN" Style="{StaticResource DarkButton}" 
                            Width="50" Height="30" Margin="0,0,4,0" 
                            HorizontalAlignment="Right" Click="Run_Click"/>
                </StackPanel>

                <!-- Canvas Display -->
                <Border Grid.Row="3" Margin="4" Background="#0a0e27">
                    <wv2:WebView2 Name="CanvasDisplay" />
                </Border>

                <!-- Footer Status -->
                <Border Grid.Row="4" Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="0,1,0,0">
                    <TextBlock x:Name="CommandStatus" Text="Ready" Foreground="#00ff00" Margin="8,8"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================
             RIGHT PANEL: Phase State + Chat History
             ============================================================ -->
        <Border Grid.Row="1" Grid.Column="2" Background="#0a0e27" BorderBrush="#00ff00" BorderThickness="1,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="◆ PHASE STATE" Foreground="#00ff99" FontWeight="Bold" Margin="8,4"/>
                
                <StackPanel Grid.Row="1" Margin="8">
                    <Border Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="1" Margin="0,4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Current Phase:" Foreground="#00ff00" FontSize="10"/>
                            <TextBlock x:Name="CurrentPhaseText" Text="POP (initialization)" Foreground="#00ff99" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="1" Margin="0,4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Execution Time:" Foreground="#00ff00" FontSize="10"/>
                            <TextBlock x:Name="ExecutionTimeText" Text="0ms" Foreground="#00ff99" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="1" Margin="0,4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="Mode:" Foreground="#00ff00" FontSize="10"/>
                            <TextBlock x:Name="ModeText" Text="ORCHESTRATE" Foreground="#00ff99" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1a1e37" BorderBrush="#00ff00" BorderThickness="1" Margin="0,4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="LLAMA Status:" Foreground="#00ff00" FontSize="10"/>
                            <TextBlock x:Name="LlamaStatusText" Text="[OFFLINE]" Foreground="#ff6600" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Geodesic state from Local\KuhulGeometricState shared memory -->
                    <Border Background="#1a1e37" BorderBrush="#00ff99" BorderThickness="1" Margin="0,4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="GEODESIC STATE" Foreground="#00ff99" FontSize="10" FontWeight="Bold"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                    <RowDefinition Height="18"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="entropy  " Foreground="#00ff00" FontSize="10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ShmEntropyText"  Text="—" Foreground="#00ff99" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="attention" Foreground="#00ff00" FontSize="10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ShmAttentionText" Text="—" Foreground="#00ff99" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="pressure " Foreground="#00ff00" FontSize="10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ShmPressureText"  Text="—" Foreground="#00ff99" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="fold/tick" Foreground="#00ff00" FontSize="10"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ShmFoldTickText"  Text="—" Foreground="#00ff99" FontSize="10" FontWeight="Bold"/>
                            </Grid>
                            <TextBlock x:Name="ShmStatusText" Text="⊘ SHM offline" Foreground="#ff6600" FontSize="9" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Recent Commands:" Foreground="#00ff00" FontSize="10" Margin="0,8,0,4"/>
                    <ListBox Name="CommandHistory" Style="{StaticResource DarkListBox}" Height="120" Padding="4">
                        <ListBoxItem Content="[00:00] Ready" Foreground="#00ff00"/>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             BOTTOM-RIGHT PANEL: Chat + Inference
             ============================================================ -->
        <Border Grid.Row="2" Grid.Column="2" Background="#0a0e27" BorderBrush="#00ff00" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="💬 CHAT / INFERENCE" Foreground="#00ff99" FontWeight="Bold" Margin="8,4"/>

                <ListBox Grid.Row="1" Name="ChatPanel" Style="{StaticResource DarkListBox}" Padding="4"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
                    <ComboBox Name="InferenceMode" Width="80" Style="{StaticResource DarkComboBox}" VerticalAlignment="Center">
                        <ComboBoxItem>FAST</ComboBoxItem>
                        <ComboBoxItem>AUTO</ComboBoxItem>
                        <ComboBoxItem>DEEP</ComboBoxItem>
                    </ComboBox>
                    <TextBox Name="ChatInput" Style="{StaticResource DarkTextBox}"
                             Margin="4,0" VerticalAlignment="Center"
                             KeyDown="ChatInput_KeyDown"/>
                    <Button Name="SendButton" Content="SEND" Style="{StaticResource DarkButton}"
                            Width="60" Click="Send_Click"/>
                </StackPanel>

                <!-- Model selector — aliases only, no raw filenames -->
                <Border Grid.Row="3" Background="#0d1222" BorderBrush="#004400" BorderThickness="0,1,0,0" Padding="4,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MODEL:" Foreground="#006600" FontSize="10" FontFamily="Courier New"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Name="ModelSelector" Style="{StaticResource DarkComboBox}"
                                  Height="24" FontSize="10" MinWidth="200"
                                  VerticalAlignment="Center"
                                  SelectionChanged="ModelSelector_Changed">
                            <!-- GPU-resident (fits HD 4600 ≤1792 MB) -->
                            <ComboBoxItem Tag="qwen-story">Qwen Story — creative (644 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="gemma-1b">Gemma 1B QAT — fastest (687 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="lfm2">LFM2 1.2B — 128K ctx (1188 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="gemma-1b-q8">Gemma 1B Q8 — quality (1020 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="mgguf-gpt2">GPT-2 MoE — 2-expert ASX (1408 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="gpt2-xl">GPT-2 XL — MCP baked (1668 MB GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="from_zero">from_zero — K'UHUL Chat (GPU)</ComboBoxItem>
                            <ComboBoxItem Tag="kxml">KXML — Tool Agent (GPU)</ComboBoxItem>
                            <!-- CPU-only -->
                            <ComboBoxItem Tag="mgguf-qwen">Qwen MoE — 1-expert ASX (1862 MB CPU)</ComboBoxItem>
                            <ComboBoxItem Tag="dolphin">Dolphin Phi-2 — creative (1844 MB CPU)</ComboBoxItem>
                            <ComboBoxItem Tag="phi3-mini">Phi-3 Mini — micronaut tool (2282 MB CPU)</ComboBoxItem>
                            <ComboBoxItem Tag="gemma-4b">Gemma 3 4B — mid (CPU, downloading)</ComboBoxItem>
                            <ComboBoxItem Tag="gemma-4-e2b">Gemma 4 Vision — multimodal (4.2 GB CPU)</ComboBoxItem>
                            <ComboBoxItem Tag="qwen-1b8">Qwen 1.8B — multilingual (convert req'd)</ComboBoxItem>
                            <ComboBoxItem Tag="gpt-oss">GPT-OSS 20B — distillation teacher (CPU)</ComboBoxItem>
                        </ComboBox>
                        <TextBlock x:Name="ModelGpuTag" Text="" Foreground="#008800" FontSize="9"
                                   FontFamily="Courier New" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
