/* ========================================================
   gravity.kuhul — gravity / field physics semantics

   Domain semantic module: depends on pi.kuhul, independent
   of any GPU backend. Gravity is reusable across CPU, GLSL,
   HLSL, simulation, SVG-3D tensor geometry, and SCXQ2 —
   no backend baked into the physics layer.

   Dependency direction:
     pi.kuhul  ->  gravity.kuhul  ->  GLSL.kuhul  ->  opengl.khl
                                                     ->  glsl_gpu sidecar

   Compile:  python tools/khlc.py --provider gravity drivers/khl/gravity.kuhul
   Admit:    python tools/kson_validate.py drivers/khl/gravity.kson
   ======================================================== */

include "pi.kuhul"

⟁ Pop ⟁
  bind G = 9.80665
  bind mass
  bind position
  bind radius

⟁ Wo ⟁
  bind distance
  bind field
  bind potential

⟁ Yax ⟁
  resolve gravity.field
  resolve gravity.acceleration

⟁ Sek ⟁
  dispatch gravity.solve

⟁ Ch'en ⟁
  collect_status field
  collect_status acceleration

⟁ Xul ⟁
  commit gravity.state
